---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Client-side only initialization (no SSR window access)
---

<button
  type="button"
  class={`sound-btn ${className || ''}`}
  aria-label="Toggle sounds"
  data-cuelume-toggle
  onclick="window.__AUDIO_ENGINE__?.toggleEnabled(); localStorage.setItem('ai-security-matrix-audio', document.querySelector('.sound-btn').classList.toggle('muted') ? '0' : '1')"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16">
    <path d="M11 5L6 9H2v6h4l5 4V5z"/>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
  </svg>
  <span class="label">Audio</span>
</button>

<script is:inline>
  // Restore from localStorage on load
  const saved = localStorage.getItem('ai-security-matrix-audio');
  if (saved === '0') document.querySelector('.sound-btn')?.classList.add('muted');
</script>

<style>
  .sound-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0 10px; min-height: 44px; background: none;
    border: 1px solid var(--rule); border-radius: 22px;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--stale);
    cursor: pointer; transition: all 0.2s ease; line-height: 1;
  }
  .sound-btn:hover {
    color: var(--alive); border-color: var(--scope-ink);
    box-shadow: 0 0 0 2px rgba(0,153,120,0.28);
  }
  .sound-btn:active { transform: scale(0.96); }
  @media (max-width: 640px) { .sound-btn span.label { display: none; } }
</style>
