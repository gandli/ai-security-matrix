---
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh';
  canonical?: string;
}

const {
  title,
  description,
  lang = "en",
  canonical,
} = Astro.props;

const isZh = lang === "zh";
const pageTitle = title || (isZh ? "AI 赋能安全测试工具 — AI 安全矩阵" : "AI-enabled security testing tools — AI Security Matrix");
const pageDescription = description || (isZh ? "一份精选的 AI 赋能网络安全测试与红队工具目录。" : "A curated list of AI-enabled security testing tools.");
const prefix = isZh ? "/zh" : "";
const switchHref = isZh ? Astro.url.pathname.replace(/^\/zh/, "") || "/" : `/zh${Astro.url.pathname}`;

import "@/styles/global.css";
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical || Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Security Matrix" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url.href} />

    <script is:inline>
      // theme init
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.dataset.theme = saved;
      // reflect current theme on icons
      const applyThemeIcon = () => {
        const dark = document.documentElement.dataset.theme !== "light";
        document.querySelectorAll(".theme-icon-sun").forEach((el) => (el.style.display = dark ? "none" : ""));
        document.querySelectorAll(".theme-icon-moon").forEach((el) => (el.style.display = dark ? "" : "none"));
      };
      applyThemeIcon();
      document.getElementById("theme-btn")?.addEventListener("click", () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        applyThemeIcon();
      });
    </script>
  </head>
  <body>
    <div class="wrap">
      <!-- Site Header -->
      <header class="site-header">
        <div>
          <h1>
            <a href={`${prefix}/`} class="brand">
              <svg width="22" height="22" viewBox="0 0 19 19" role="img" aria-label="AI Security Matrix">
                <rect x="0.6" y="0.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="7" y="0" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="14.6" y="0.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="0" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="7" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="14" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="0" y="14" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="7.6" y="14.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="14" y="14" width="5" height="5" rx="0.5" fill="currentColor" />
              </svg>
              <span class="brand-title">AI Security <em>Matrix</em></span>
            </a>
          </h1>
          <p class="tagline">
            {isZh
              ? "一份精选的 AI 赋能网络安全测试与红队工具目录。"
              : "A curated list of AI-enabled security testing tools."}
          </p>
        </div>

        <nav class="site-nav" aria-label="Site">
          <a href={`${prefix}/about`}>{isZh ? "关于" : "About"}</a>
          <a href={`${prefix}/guide`}>{isZh ? "使用指南" : "Definitions"}</a>
          <a href={`${prefix}/contribute`}>{isZh ? "贡献" : "Contribute"}</a>
          <a href={`${prefix}/commercial`}>{isZh ? "商业工具" : "Commercial tools"}</a>

          <!-- Language toggle -->
          <a
            href={isZh ? switchHref : `/zh${Astro.url.pathname}`}
            class="icon-btn"
            aria-label={isZh ? "Switch to English" : "切换为中文"}
            title={isZh ? "English" : "中文"}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
            <span class="icon-label">{isZh ? "EN" : "中"}</span>
          </a>

          <!-- Theme toggle -->
          <button id="theme-btn" class="icon-btn" type="button" aria-label={isZh ? "切换明暗主题" : "Toggle dark/light theme"} title={isZh ? "明暗主题" : "Theme"}>
            <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </header>

      <!-- Main Slot -->
      <main>
        <slot />
      </main>

      <!-- Site Footer -->
      <footer class="site-footer">
        <nav aria-label="Pages">
          <a href={`${prefix}/about`}>{isZh ? "关于" : "About"}</a>
          <a href={`${prefix}/guide`}>{isZh ? "使用指南" : "Definitions"}</a>
          <a href={`${prefix}/contribute`}>{isZh ? "贡献" : "Contribute"}</a>
          <a href={`${prefix}/commercial`}>{isZh ? "商业工具" : "Commercial tools"}</a>
          <a href="https://github.com/gandli/ai-security-matrix" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <p>
          {isZh
            ? "© 2026 AI Security Matrix · 开源镜像维护者 gandli/ai-security-matrix"
            : "© 2026 AI Security Matrix · Independent replica by gandli/ai-security-matrix"}
        </p>
      </footer>
    </div>

    <script is:inline>
      document.getElementById("theme-btn")?.addEventListener("click", () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
