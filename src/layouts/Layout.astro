---
import "@/styles/global.css";
import { url, home, asset, type Lang } from "@/lib/url";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  lang = "en",
  canonical,
  ogImage: ogImageProp,
  ogImageAlt,
} = Astro.props;

const isZh = lang === "zh";
const pageTitle = title || (isZh ? "AI 赋能安全测试工具 — AI 安全矩阵" : "AI-enabled security testing tools — AI Security Matrix");
const pageDescription = description || (isZh ? "精选的 AI 赋能网络安全测试与红队工具目录，aisecuritymatrix.com 镜像。" : "A curated list of AI-enabled security testing tools (mirror of aisecuritymatrix.com).");

// Strip any existing base/language prefix to compute switch target
const pathname = Astro.url.pathname;
const baseNoSlash = import.meta.env.BASE_URL.replace(/^\/|\/$/g, "");
let relative = pathname;
if (baseNoSlash && relative.startsWith(`/${baseNoSlash}`)) {
  relative = relative.slice(`/${baseNoSlash}`.length);
}
relative = relative.replace(/^\/+/, "");

// Language toggle href
let switchHref: string;
if (isZh) {
  const enRel = relative.replace(/^zh\/?/, "");
  switchHref = url(enRel, "en");
} else {
  switchHref = url(relative, "zh");
}

const homeHref = home(lang);
const faviconHref = asset("favicon.svg");
const ogImage = ogImageProp || `https://gandli.github.io/ai-security-matrix/og-image${isZh ? ".zh" : ""}.png`;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="canonical" href={canonical || Astro.url.href} />
    <meta name="theme-color" content="#001615" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f4f5" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://github.com" crossorigin />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="preconnect" href="https://img.shields.io" crossorigin />
    <link rel="preconnect" href="https://opengraph.githubassets.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Security Matrix" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || (isZh ? "AI 安全矩阵 — 精选的 AI 赋能安全测试工具" : "AI Security Matrix — curated AI security testing tools")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // theme init — runs in <head>, before the toggle button exists in the DOM
      (function () {
        const saved = localStorage.getItem("theme");
        if (saved) document.documentElement.dataset.theme = saved;

        const applyThemeIcon = () => {
          const dark = document.documentElement.dataset.theme !== "light";
          document.querySelectorAll(".theme-icon-sun").forEach((el) => (el.style.display = dark ? "none" : ""));
          document.querySelectorAll(".theme-icon-moon").forEach((el) => (el.style.display = dark ? "" : "none"));
        };
        applyThemeIcon();

        // Bind after the button is parsed; the script itself runs too early otherwise.
        const bind = () => {
          const btn = document.getElementById("theme-btn");
          if (!btn) return;
          btn.addEventListener("click", () => {
            const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
            document.documentElement.dataset.theme = next;
            localStorage.setItem("theme", next);
            applyThemeIcon();
          });
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bind, { once: true });
        } else {
          bind();
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{isZh ? "跳到主要内容" : "Skip to main content"}</a>
    <div class="wrap">
      <!-- Site Header -->
      <header class="site-header">
        <div>
          <h1>
            <a href={homeHref} class="brand">
              <svg width="22" height="22" viewBox="0 0 19 19" role="img" aria-label="AI Security Matrix">
                <rect x="0.6" y="0.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="7" y="0" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="14.6" y="0.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="0" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="7" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="14" y="7" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="0" y="14" width="5" height="5" rx="0.5" fill="currentColor" />
                <rect x="7.6" y="14.6" width="3.8" height="3.8" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                <rect x="14" y="14" width="5" height="5" rx="0.5" fill="currentColor" />
              </svg>
              <span class="brand-title">AI Security <em>Matrix</em></span>
            </a>
          </h1>
          <p class="tagline">
            {isZh
              ? "精选的 AI 赋能网络安全测试与红队工具目录，aisecuritymatrix.com 镜像。"
              : "A curated list of AI-enabled security testing tools (mirror of aisecuritymatrix.com)."}
          </p>
        </div>

        <nav class="site-nav" aria-label="Site">
          <div class="nav-links">
            <a href={url("about", lang)}>{isZh ? "关于" : "About"}</a>
            <a href={url("guide", lang)}>{isZh ? "指南" : "Guide"}</a>
            <a href={url("contribute", lang)}>{isZh ? "贡献" : "Submit"}</a>
            <a href={url("commercial", lang)}>{isZh ? "商业" : "Vendors"}</a>
          </div>

          <div class="nav-actions">
            <!-- Language toggle -->
            <a
              href={switchHref}
              class="icon-btn"
              aria-label={isZh ? "Switch to English" : "切换为中文"}
              title={isZh ? "English" : "中文"}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
              <span class="icon-label">{isZh ? "EN" : "中"}</span>
            </a>

            <!-- Theme toggle -->
            <button id="theme-btn" class="icon-btn" type="button" aria-label={isZh ? "切换明暗主题" : "Toggle dark/light theme"} title={isZh ? "明暗主题" : "Theme"}>
              <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </button>
          </div>
        </nav>
      </header>

      <!-- Main Slot -->
      <main id="main" tabindex="-1">
        <slot />
      </main>

      <!-- Site Footer -->
      <footer class="site-footer">
        <nav aria-label="Pages">
          <a href={url("about", lang)}>{isZh ? "关于" : "About"}</a>
          <a href={url("guide", lang)}>{isZh ? "指南" : "Guide"}</a>
          <a href={url("contribute", lang)}>{isZh ? "贡献" : "Submit"}</a>
          <a href={url("commercial", lang)}>{isZh ? "商业" : "Vendors"}</a>
          <a href="https://github.com/gandli/ai-security-matrix" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <p>
          {isZh
            ? "© 2026 AI Security Matrix · 开源镜像维护者 gandli/ai-security-matrix"
            : "© 2026 AI Security Matrix · Independent replica by gandli/ai-security-matrix"}
        </p>
      </footer>
    </div>
  </body>
</html>

<!-- Audio engine init -->
<script type="module" is:inline={true}>
  // Inject sound engine
  import { audio } from '@/lib/audio/sounds.js';
  
  window.__AUDIO_ENGINE__ = audio;
  
  // Initialize on first interaction (browser policy)
  function initAudio() {
    if (!window.__AUDIO_INITED__) {
      audio.init();
      window.__AUDIO_INITED__ = true;
      
      // Global event delegation for sounds
      document.addEventListener('mouseenter', (e) => {
        const el = e.target.closest('a, button, [data-sound-hover]');
        if (el && window.__AUDIO_ENGINE__.enabled) {
          window.__AUDIO_ENGINE__.play('hover');
        }
      });
      
      document.addEventListener('mousedown', (e) => {
        const el = e.target.closest('a, button, [data-sound-click]');
        if (el && window.__AUDIO_ENGINE__.enabled) {
          window.__AUDIO_ENGINE__.play('click');
        }
      });
      
      document.addEventListener('focusin', (e) => {
        const el = e.target.closest('a, input, button, [data-sound-focus]');
        if (el && window.__AUDIO_ENGINE__.enabled) {
          window.__AUDIO_ENGINE__.play('focus');
        }
      });
    }
  }
  
  // Init on user gesture
  window.__AUDIO_INIT__ = () => {
    initAudio();
    return Promise.resolve();
  };
  
  // Audio is on by default; no toggle UI.
  window.__AUDIO_ENABLED__ = true;
</script>
