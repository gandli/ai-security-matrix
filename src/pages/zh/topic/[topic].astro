---
import Layout from "@/layouts/Layout.astro";
import TermList from "@/components/TermList.astro";
import siteData from "@/data/site.json";

export function getStaticPaths() {
  const topics = [...new Set(siteData.flatMap((i) => i.derived?.identity?.topics || []))].sort();
  return topics.map((topic) => ({ params: { topic }, props: { topic } }));
}

const { topic } = Astro.props;
const tools = siteData.filter((i) => (i.derived?.identity?.topics || []).includes(topic));
const title = topic.replace(/-/g, " ");
const desc = `AI 安全矩阵中标记为“${topic.replace(/-/g, " ")}”的工具共 ${tools.length} 款。数据来自 aisecuritymatrix.com。`;
---

<Layout lang="zh" title={`${title} — ${tools.length} 款工具 · AI 安全矩阵`} description={desc}>
  <TermList
    title={title}
    description={desc}
    items={tools}
    count={tools.length}
    lang="zh"
    anchorPrefix="topic"
  />
</Layout>
