---
import Layout from "@/layouts/Layout.astro";
import siteData from "@/data/site.json";
import { home } from "@/lib/url";

export function getStaticPaths() {
  return siteData.map((item) => ({
    params: { slug: item.entry.repo.replace("/", "-") },
    props: { item },
  }));
}

interface Item {
  entry: any;
  derived: any;
}
const { item } = Astro.props as { item: Item };
const { entry, derived } = item;
const d = derived || {};
const [owner, name] = entry.repo.split("/");
const catColor: Record<string, string> = {
  agent: "var(--cat-agent)",
  scanner: "var(--cat-scanner)",
  mcp: "var(--cat-mcp)",
  skill: "var(--cat-skill)",
};

const catZh: Record<string, string> = {
  agent: "智能体工具",
  scanner: "扫描器",
  mcp: "MCP 服务器",
  skill: "技能集",
};

const idle = (() => {
  const a = d.alive;
  if (!a || a.days_idle == null) return "—";
  if (a.archived) return "已归档";
  const n = a.days_idle;
  if (n < 1) return "今天";
  if (n < 365) return `${n} 天前`;
  return `${(n / 365).toFixed(1)} 年前`;
})();

const stars = d.identity?.stars != null
  ? d.identity.stars >= 1000
    ? `${(d.identity.stars / 1000).toFixed(1)}k`
    : String(d.identity.stars)
  : "—";

const risks = Object.keys(d.risk || {}).filter((k) => d.risk[k]);
const FLAG_FAMILY: Record<string, string> = {
  binaries: "host",
  installs: "host",
  root: "access",
  credentials: "access",
  "calls out": "unseen",
  opaque: "unseen",
};

const CHECK_LABELS: Record<string, string> = {
  binaries: "是否包含未自行构建的预编译二进制",
  installs: "是否在主机上安装软件",
  root: "是否索取 root / sudo 权限",
  credentials: "是否读取 ~/.aws 或 ~/.ssh 等凭据路径",
  "calls out": "是否调用项目不拥有的外部端点",
  opaque: "是否包含无法阅读的超长编码数据",
};

const allChecks = Object.keys(CHECK_LABELS);
const desc = entry.description_zh || d.identity?.description || "";
---
<Layout lang="zh" title={`${entry.repo} — AI 安全矩阵`} description={desc}>
  <article class="static-doc">
    <p style="font-size: 0.8125rem; color: var(--stale);">
      <a href={home("zh")}>← 返回矩阵</a>
    </p>

    <h1 style="margin-top: 0.75rem;">
      <span style="color: var(--stale);">{owner}/</span><span style="color: var(--name);">{name}</span>
    </h1>

    <p style="margin-top: 0.5rem; font-size: 0.9375rem;">
      {desc}
    </p>

    <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
      <span style={`color: ${catColor[entry.category] || "var(--stale)"}; font-weight: 600; font-size: 0.875rem;`}>
        {catZh[entry.category] || entry.category}
      </span>
      <span style="color: var(--rule-strong);">·</span>
      <a href={entry.repo ? `https://github.com/${entry.repo}` : "#"} target="_blank" rel="noopener" style="font-family: var(--font-mono); font-size: 0.8125rem;">
        github.com/{entry.repo} ↗
      </a>
    </div>

    <!-- Stat grid -->
    <div class="tool-detail-grid">
      <div class="stat-item">
        <div class="label">Stars</div>
        <div class="value" style="color: var(--star);">★ {stars}</div>
      </div>
      <div class="stat-item">
        <div class="label">最近更新</div>
        <div class="value">{idle}</div>
      </div>
      <div class="stat-item">
        <div class="label">开源许可证</div>
        <div class="value" style="font-size: 1rem;">{d.licence?.file || "—"}</div>
      </div>
      <div class="stat-item">
        <div class="label">贡献者数</div>
        <div class="value">{d.identity?.contributors ?? "—"}</div>
      </div>
      <div class="stat-item">
        <div class="label">代码规模</div>
        <div class="value" style="font-size: 1rem;">
          {d.shape?.loc ? d.shape.loc.toLocaleString() : "—"} 行
        </div>
        <div class="sub">{d.shape?.code_files ?? "—"} 个代码文件</div>
      </div>
      <div class="stat-item">
        <div class="label">Forks</div>
        <div class="value">{d.identity?.forks?.toLocaleString() ?? "—"}</div>
      </div>
    </div>

    <!-- Scope -->
    {entry.scope?.length ? (
      <section>
        <h2>作用范围</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
          {entry.scope.map((s: string) => <span class="pill pill-scope">{s}</span>)}
        </div>
      </section>
    ) : null}

    <!-- Bundled tools -->
    {d.bundled?.length ? (
      <section>
        <h2>内置工具</h2>
        <p style="font-family: var(--font-mono); font-size: 0.8125rem;">
          {d.bundled.join(", ")}
        </p>
      </section>
    ) : null}

    <!-- Shares files with -->
    {d.shares_with ? (
      <section>
        <h2>共享文件项目</h2>
        <p style="font-family: var(--font-mono); font-size: 0.8125rem;">{d.shares_with}</p>
      </section>
    ) : null}

    <!-- Safety checklist -->
    <section>
      <h2>运行前安全检查</h2>
      <table class="checklist-table">
        <tbody>
          {allChecks.map((k) => {
            const val = d.risk ? d.risk[k] : null;
            const label = val === true ? "是" : val === false ? "否" : "未检查";
            const cls = val === true ? "ans-yes" : val === false ? "ans-no" : "";
            return (
              <tr>
                <td>{CHECK_LABELS[k]}</td>
                <td class={cls}>{label}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>

    <!-- Risk flags -->
    {risks.length ? (
      <section>
        <h2>风险标记</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
          {risks.map((k) => <span class={`pill pill-${FLAG_FAMILY[k] || "host"}`}>{k}</span>)}
        </div>
      </section>
    ) : null}

    <!-- Topics -->
    {d.identity?.topics?.length ? (
      <section>
        <h2>标签（Topics）</h2>
        <p style="font-size: 0.8125rem; color: var(--stale);">{d.identity.topics.join(" · ")}</p>
      </section>
    ) : null}

    <p style="margin-top: 3rem; font-size: 0.75rem; color: var(--dead);">
      数据检查于 {d.checked_at || "—"} · 来源于 aisecuritymatrix.com
    </p>
  </article>
</Layout>
