---
import Layout from "@/layouts/Layout.astro";
import { home } from "@/lib/url";
import translations from "@/../translations.json";

const toolSlugs = Object.keys(translations.tools || {}).sort();
const ISSUES_URL = "https://github.com/gandli/ai-security-matrix/issues/new";

const JSON_SAMPLE = `{
  "tools": {
    "usestrix-strix": "开源 AI 渗透测试工具，用于发现并修复应用中的漏洞。"
  }
}`;
---

<Layout
  lang="zh"
  title="贡献 — AI 安全矩阵"
  description="修正翻译、推荐新工具、报告数据问题——表单自动生成预填的 GitHub Issue。"
>
  <article class="static-doc">
    <p class="crumb"><a href={home("zh")}>← 返回目录</a></p>

    <h1>贡献</h1>

    <p class="lede">
      本仓库是 <a href="https://aisecuritymatrix.com" target="_blank" rel="noopener">aisecuritymatrix.com</a> 的社区镜像，
      每天自动同步一次。工具清单本身不在这里维护，但<strong>翻译、说明文字和展示层</strong>完全由本仓库掌控，
      欢迎直接提 PR。
    </p>

    <!-- ==================== 提交表单 ==================== -->
    <h2>提交</h2>
    <p class="note">
      填写表单后会自动打开一条预填好的 GitHub Issue。本站不需要登录，
      但 GitHub 会要求你先登录才能创建 Issue。
    </p>

    <div class="form-tabs" role="tablist" aria-label="提交类型">
      <button type="button" role="tab" class="ftab is-active" id="tab-translation" aria-selected="true" aria-controls="panel-translation" data-panel="translation">修正翻译</button>
      <button type="button" role="tab" class="ftab" id="tab-new-tool" aria-selected="false" aria-controls="panel-new-tool" data-panel="new-tool">推荐新工具</button>
      <button type="button" role="tab" class="ftab" id="tab-data" aria-selected="false" aria-controls="panel-data" data-panel="data">报告数据</button>
    </div>

    <!-- 修正翻译 -->
    <div id="panel-translation" role="tabpanel" aria-labelledby="tab-translation" class="fpanel is-active">
      <form class="sub-form" data-kind="translation">
        <label>
          <span>工具</span>
          <select name="slug" required>
            <option value="" disabled selected>选择工具…</option>
            {toolSlugs.map((slug: string) => <option value={slug}>{slug}</option>)}
          </select>
        </label>
        <label>
          <span>建议的中文描述</span>
          <textarea name="zh" rows="3" required
            placeholder="开源 AI 渗透测试工具，用于发现并修复应用中的漏洞。"
          ></textarea>
        </label>
        <label>
          <span>修改原因 <em>（选填）</em></span>
          <input name="reason" type="text" autocomplete="off" placeholder="例如：当前版本把 red team 翻译错了…" />
        </label>
        <button type="submit" class="submit-btn">打开 GitHub Issue →</button>
      </form>
    </div>

    <!-- 推荐新工具 -->
    <div id="panel-new-tool" role="tabpanel" aria-labelledby="tab-new-tool" class="fpanel" hidden>
      <p class="form-note">
        工具收录在上游
        <a href="https://aisecuritymatrix.com" target="_blank" rel="noopener">aisecuritymatrix.com</a>
        完成。在此提交会同时创建 Issue，便于两边追踪。
      </p>
      <form class="sub-form" data-kind="new-tool">
        <label>
          <span>GitHub 仓库地址</span>
          <input name="repo" type="url" required autocomplete="off" placeholder="https://github.com/owner/repo…"
            pattern="https://github\.com/[^/]+/[^/]+.*" />
        </label>
        <label>
          <span>类别</span>
          <select name="category" required>
            <option value="" disabled selected>选择…</option>
            <option value="agent">agent — 自主任务循环</option>
            <option value="scanner">scanner — 固定检查、报告发现</option>
            <option value="mcp">mcp — 通过 MCP 把工具提供给模型</option>
            <option value="skill">skill — 给模型的提示词与指令</option>
          </select>
        </label>
        <fieldset>
          <legend>测试范围</legend>
          {["ad","agentic","api","binary","cloud","code","entra","llm","logging","modfile","network","recon","redteam","social","webapp"].map((s) => (
            <label class="scope-check">
              <input type="checkbox" name="scope" value={s} /> {s}
            </label>
          ))}
        </fieldset>
        <label>
          <span>为什么适合收录 <em>（选填）</em></span>
          <textarea name="reason" rows="2" autocomplete="off" placeholder="例如：第一个覆盖 X 的开源工具…"></textarea>
        </label>
        <button type="submit" class="submit-btn">打开 GitHub Issue →</button>
      </form>
    </div>

    <!-- 报告数据 -->
    <div id="panel-data" role="tabpanel" aria-labelledby="tab-data" class="fpanel" hidden>
      <form class="sub-form" data-kind="data">
        <label>
          <span>工具</span>
          <select name="slug" required>
            <option value="" disabled selected>选择工具…</option>
            {toolSlugs.map((slug: string) => <option value={slug}>{slug}</option>)}
          </select>
        </label>
        <label>
          <span>哪里不对？</span>
          <select name="field" required>
            <option value="" disabled selected>选择…</option>
            <option value="stars">星级数不对</option>
            <option value="flags">风险标记不对</option>
            <option value="description">描述不对</option>
            <option value="category">分类不对</option>
            <option value="other">其他</option>
          </select>
        </label>
        <label>
          <span>期望值</span>
          <textarea name="expected" rows="2" required
            placeholder="例如：应标记 credentials，因为 setup.sh 会读取 ~/.aws…"></textarea>
        </label>
        <button type="submit" class="submit-btn">打开 GitHub Issue →</button>
      </form>
    </div>

    <!-- ==================== 手动路径 ==================== -->
    <h2>手动贡献</h2>

    <h3>通过 Pull Request 修正翻译</h3>

    <p>
      打开 <a href="https://github.com/gandli/ai-security-matrix/blob/astro-site/translations.json" target="_blank" rel="noopener"><code>translations.json</code></a>，
      在 <code>tools</code> 对象中按工具 slug 找到条目并改写：
    </p>

    <pre><code>{JSON_SAMPLE}</code></pre>

    <p>
      键名是站点的工具 slug（即详情页 URL 的最后一段，如 <code>/zh/tools/usestrix-strix/</code>）。
      提交后次日同步会自动保留你的译文——同步脚本只覆盖抓取到的字段，不会动这个文件。
    </p>

    <h3>报告数据问题</h3>

    <p>
      如果某个工具的星级、风险标记或描述与实际不符，问题多半出在上游站点。
      请先到 <a href="https://aisecuritymatrix.com" target="_blank" rel="noopener">aisecuritymatrix.com</a> 确认；
      若上游正确而本仓库错误，请<a href={ISSUES_URL} target="_blank" rel="noopener">开 issue</a>并附上工具链接与期望值。
    </p>

    <h3>改进页面与样式</h3>

    <p>
      页面模板在 <code>src/pages/</code>，共享组件在 <code>src/components/</code>，
      设计令牌与全部样式在 <code>src/styles/global.css</code>。
      改动前请阅读根目录的 <code>DESIGN.md</code>——它记录了配色、字阶与间距系统。
    </p>

    <h2>本地运行</h2>

    <pre><code>git clone https://github.com/gandli/ai-security-matrix.git
cd ai-security-matrix
npm install
npm run dev      # http://localhost:4321/ai-security-matrix/</code></pre>

    <p>提交前请确认构建与测试通过：</p>

    <pre><code>npm run build          # 生成 688 个静态页
npx playwright test    # 端到端测试（164 passed）</code></pre>

    <h2>提交前的检查清单</h2>

    <ul>
      <li>中英文两个版本都改了（若涉及文案）</li>
      <li>明暗两种主题都看过</li>
      <li>移动端窄至 320px 不溢出</li>
      <li><code>npm run build</code> 无错误</li>
      <li>一次 PR 只做一件事，便于回滚</li>
    </ul>

    <h2>关于上游</h2>

    <p>
      工具清单的选题、分类与风险审计标准由
      <a href="https://aisecuritymatrix.com" target="_blank" rel="noopener">aisecuritymatrix.com</a> 制定。
      若想新增一个工具或调整分类归属，请在上游提出；本仓库同步后会自动收录。
    </p>
  </article>

  <script>
    // Tab switching
    document.querySelectorAll(".ftab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".ftab").forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        document.querySelectorAll(".fpanel").forEach((p) => {
          p.classList.remove("is-active");
          p.hidden = true;
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");
        const panel = document.getElementById("panel-" + btn.dataset.panel);
        if (panel) { panel.hidden = false; panel.classList.add("is-active"); }
      });
    });

    const REPO_ISSUES = "https://github.com/gandli/ai-security-matrix/issues/new";

    function openIssue(title: string, body: string) {
      const url = REPO_ISSUES
        + "?title=" + encodeURIComponent(title)
        + "&body=" + encodeURIComponent(body);
      window.open(url, "_blank", "noopener,noreferrer");
    }

    document.querySelectorAll(".sub-form").forEach((form) => {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const fd = new FormData(form as HTMLFormElement);
        const kind = (form as HTMLElement).dataset.kind;

        if (kind === "translation") {
          const slug = fd.get("slug") as string;
          const zh = (fd.get("zh") as string).trim();
          const reason = (fd.get("reason") as string || "").trim();
          const body = [
            "## 修正翻译",
            "",
            "**工具：** `" + slug + "`",
            "**建议中文描述：**",
            "",
            "> " + zh,
            "",
            reason ? "**原因：** " + reason : "",
            "",
            "---",
            "_来自贡献页表单 · " + new Date().toISOString().slice(0, 10) + "_",
          ].filter(Boolean).join("\n");
          openIssue("修正翻译: " + slug, body);

        } else if (kind === "new-tool") {
          const repo = (fd.get("repo") as string).trim();
          const category = fd.get("category") as string;
          const scopes = fd.getAll("scope") as string[];
          const reason = (fd.get("reason") as string || "").trim();
          const body = [
            "## 推荐新工具",
            "",
            "**仓库：** " + repo,
            "**类别：** " + category,
            "**范围：** " + (scopes.length ? scopes.map(s => "`" + s + "`").join(", ") : "—"),
            "",
            reason ? "**理由：** " + reason : "",
            "",
            "⚠️ _收录在上游 aisecuritymatrix.com 完成。此 Issue 便于本镜像追踪。_",
            "",
            "---",
            "_来自贡献页表单 · " + new Date().toISOString().slice(0, 10) + "_",
          ].filter(Boolean).join("\n");
          const slug = repo.replace("https://github.com/", "").replace(/\/$/, "");
          openIssue("新工具: " + slug + " (" + category + ")", body);

        } else if (kind === "data") {
          const slug = fd.get("slug") as string;
          const field = fd.get("field") as string;
          const expected = (fd.get("expected") as string).trim();
          const body = [
            "## 数据问题",
            "",
            "**工具：** `" + slug + "`",
            "**字段：** " + field,
            "**期望值：** " + expected,
            "",
            "---",
            "_来自贡献页表单 · " + new Date().toISOString().slice(0, 10) + "_",
          ].join("\n");
          openIssue("数据问题: " + slug + " — " + field, body);
        }
      });
    });
  </script>

  <style>
    .crumb { font-size: 0.875rem; color: var(--stale); }
    .lede { font-size: 1rem; line-height: 1.7; color: var(--alive); max-width: 68ch; }
    .note { font-size: 0.875rem; color: var(--stale); max-width: 68ch; margin-top: 0.375rem; }
    .form-note { font-size: 0.8125rem; color: var(--stale); max-width: 68ch; }

    .form-tabs {
      display: flex; flex-wrap: wrap; gap: 0.25rem;
      border-bottom: 1px solid var(--rule);
      margin: 1.25rem 0 0;
    }
    .ftab {
      padding: 0.5rem 0.875rem;
      min-height: 44px;
      font-family: inherit; font-size: 0.875rem; font-weight: 500;
      color: var(--stale);
      background: transparent;
      border: none; border-bottom: 2px solid transparent;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .ftab:hover { color: var(--alive); }
    .ftab.is-active { color: var(--alive); border-bottom-color: var(--name); }

    .fpanel { margin-top: 1rem; }
    .fpanel[hidden] { display: none; }

    .sub-form {
      max-width: 34rem;
      display: flex; flex-direction: column; gap: 0.875rem;
      margin-bottom: 2rem;
    }
    .sub-form label {
      display: flex; flex-direction: column; gap: 0.375rem;
      font-size: 0.8125rem; font-weight: 500; color: var(--stale);
    }
    .sub-form label em { font-weight: 400; font-style: italic; color: var(--dead); }
    .sub-form input, .sub-form select, .sub-form textarea {
      font-family: inherit; font-size: 0.875rem;
      padding: 0.5rem 0.625rem;
      min-height: 44px;
      background: var(--paper-raised);
      border: 1px solid var(--rule);
      border-radius: 6px;
      color: var(--alive);
      transition: border-color 0.15s;
    }
    .sub-form input:focus-visible, .sub-form select:focus-visible, .sub-form textarea:focus-visible {
      border-color: var(--scope-ink);
      outline: none;
    }
    .sub-form textarea { resize: vertical; }
    .sub-form fieldset {
      border: 1px solid var(--rule); border-radius: 6px;
      padding: 0.625rem 0.75rem; margin: 0;
    }
    .sub-form fieldset legend {
      font-size: 0.8125rem; font-weight: 500; color: var(--stale);
      padding: 0 0.375rem;
    }
    .scope-check {
      display: inline-flex !important;
      flex-direction: row !important;
      align-items: center;
      gap: 0.25rem;
      margin-right: 0.5rem; margin-bottom: 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.75rem; font-weight: 400;
      min-height: 44px;
    }
    .scope-check input { width: auto; min-height: auto; margin: 0; }
    .submit-btn {
      align-self: flex-start;
      padding: 0.625rem 1.25rem;
      min-height: 44px;
      font-family: inherit; font-size: 0.875rem; font-weight: 600;
      color: var(--name-ink);
      background: var(--name);
      border: none; border-radius: 6px;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
    }
    .submit-btn:hover { opacity: 0.88; }
    .submit-btn:active { transform: scale(0.98); }
    .submit-btn:focus-visible {
      outline: 2px solid var(--scope-ink);
      outline-offset: 2px;
    }

    .static-doc h3 {
      margin-top: 1.75rem;
      font-size: 1rem; font-weight: 600; color: var(--name);
    }
    .static-doc ul {
      max-width: 68ch; padding-left: 1.25rem; line-height: 1.7;
    }
    .static-doc li { margin-bottom: 0.25rem; }
    .static-doc pre { max-width: 68ch; overflow-x: auto; }
    .static-doc :global(code) { font-size: 0.875rem; }
  </style>
</Layout>
