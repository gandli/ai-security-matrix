---
import Layout from "@/layouts/Layout.astro";
import ToolBadges from "@/components/ToolBadges.astro";
import siteData from "@/data/site.json";
import { home, url } from "@/lib/url";

export function getStaticPaths() {
  return siteData.map((item) => ({
    params: { slug: item.entry.repo.replace("/", "-") },
    props: { item },
  }));
}

interface Item {
  entry: any;
  derived: any;
}
const { item } = Astro.props as { item: Item };
const { entry, derived } = item;
const d = derived || {};
const [owner, name] = entry.repo.split("/");
const catColor: Record<string, string> = {
  agent: "var(--cat-agent)",
  scanner: "var(--cat-scanner)",
  mcp: "var(--cat-mcp)",
  skill: "var(--cat-skill)",
};

const idle = (() => {
  const a = d.alive;
  if (!a || a.days_idle == null) return "—";
  if (a.archived) return "archived";
  const n = a.days_idle;
  if (n < 1) return "today";
  if (n < 365) return `${n}d`;
  return `${(n / 365).toFixed(1)}y`;
})();

const stars = d.identity?.stars != null
  ? d.identity.stars >= 1000
    ? `${(d.identity.stars / 1000).toFixed(1)}k`
    : String(d.identity.stars)
  : "—";

const risks = Object.keys(d.risk || {}).filter((k) => d.risk[k]);
const FLAG_FAMILY: Record<string, string> = {
  binaries: "host",
  installs: "host",
  root: "access",
  credentials: "access",
  "calls out": "unseen",
  opaque: "unseen",
};

const CHECK_LABELS: Record<string, string> = {
  binaries: "Ships compiled binaries you did not build",
  installs: "Installs software on your host",
  root: "Asks for root or sudo",
  credentials: "Reads credential paths such as ~/.aws or ~/.ssh",
  "calls out": "Calls an endpoint the project does not own",
  opaque: "Contains long encoded blobs you cannot read",
};

const allChecks = Object.keys(CHECK_LABELS);
const desc = d.identity?.description || "";

// GitHub's official social-preview card for this repo. Served from
// opengraph.githubassets.com; no local generation required.
const ghOg = `https://opengraph.githubassets.com/1/${entry.repo}`;

const ogTitle = `AI Security Matrix — ${owner}/${name}`;
const ogDesc = `${desc.substring(0, 140)} — AI security testing tool with risk flags and safety checklist.`;
---

<Layout lang="en" title={ogTitle} description={ogDesc} ogImage={ghOg} ogImageAlt={`GitHub social preview for ${entry.repo}`}>
  <article class="static-doc">
    <p style="font-size: 0.875rem; color: var(--stale);">
      <a href={home("en")}>← back to matrix</a>
    </p>

    <h1 style="margin-top: 0.75rem;">
      <span style="color: var(--stale);">{owner}/</span><span style="color: var(--name);">{name}</span>
    </h1>

    <p style="margin-top: 0.5rem; font-size: 1rem;">
      {desc}
    </p>

    <ToolBadges repo={entry.repo} lang="en" />

    <!-- GitHub social-preview card as illustration -->
    <figure class="gh-og">
      <img
        src={ghOg}
        alt={`GitHub social preview card for ${entry.repo}`}
        width="1200"
        height="630"
        loading="lazy"
      />
      <figcaption>
        {entry.repo} on GitHub — social preview rendered by opengraph.githubassets.com
      </figcaption>
    </figure>

    <!-- Stat grid -->
    <div class="tool-detail-grid">
      <div class="stat-item">
        <div class="label">Category</div>
        <div class="value" style="font-size: 1.125rem;">
          <a class="cat-chip" href={url(`category/${entry.category}/`, "en")} style={`--chip:${catColor[entry.category] || "var(--cat-scanner)"}`}>{entry.category}</a>
        </div>
      </div>
      <div class="stat-item">
        <div class="label">Stars</div>
        <div class="value" style="color: var(--star);">★ {stars}</div>
      </div>
      <div class="stat-item">
        <div class="label">Last updated</div>
        <div class="value">{idle}</div>
      </div>
      <div class="stat-item">
        <div class="label">Licence</div>
        <div class="value" style="font-size: 1rem;">{d.licence?.file || "—"}</div>
      </div>
      <div class="stat-item">
        <div class="label">Contributors</div>
        <div class="value">{d.identity?.contributors ?? "—"}</div>
      </div>
      <div class="stat-item">
        <div class="label">Size</div>
        <div class="value" style="font-size: 1rem;">
          {d.shape?.loc ? d.shape.loc.toLocaleString() : "—"} lines
        </div>
        <div class="sub">{d.shape?.code_files ?? "—"} code files</div>
      </div>
    </div>

    <!-- Scope (clickable → scope index) -->
    {entry.scope?.length ? (
      <section>
        <h2>Scope</h2>
        <div class="pill-row">
          {entry.scope.map((s: string) => (
            <a class="pill pill-scope pill-link" href={url(`scope/${s}/`, "en")}>{s}</a>
          ))}
        </div>
      </section>
    ) : null}

    <!-- Bundled tools -->
    {d.bundled?.length ? (
      <section>
        <h2>Bundled tools</h2>
        <p style="font-family: var(--font-mono); font-size: 0.875rem;">
          {d.bundled.join(", ")}
        </p>
      </section>
    ) : null}

    <!-- Shares files with -->
    {d.shares_with ? (
      <section>
        <h2>Shares files with</h2>
        <p style="font-family: var(--font-mono); font-size: 0.875rem;">{d.shares_with}</p>
      </section>
    ) : null}

    <!-- Before running it (safety checklist) -->
    <section>
      <h2>Before running it</h2>
      <table class="checklist-table">
        <tbody>
          {allChecks.map((k) => {
            const val = d.risk ? d.risk[k] : null;
            const label = val === true ? "yes" : val === false ? "no" : "not checked";
            const cls = val === true ? "ans-yes" : val === false ? "ans-no" : "";
            return (
              <tr>
                <td>{CHECK_LABELS[k]}</td>
                <td class={cls}>{label}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>

    <!-- Risk flags -->
    {risks.length ? (
      <section>
        <h2>Flags</h2>
        <div class="pill-row">
          {risks.map((k) => <a class={`pill pill-${FLAG_FAMILY[k] || "host"} pill-link`} href={url(`flag/${k.replace(/\s+/g, "-")}/`, "en")}>{k}</a>)}
        </div>
      </section>
    ) : null}

    <!-- Topics (clickable → topic index) -->
    {d.identity?.topics?.length ? (
      <section>
        <h2>Topics</h2>
        <div class="pill-row">
          {d.identity.topics.map((t: string) => (
            <a class="pill pill-scope pill-link" href={url(`topic/${t}/`, "en")}>{t}</a>
          ))}
        </div>
      </section>
    ) : null}

    <p style="margin-top: 3rem; font-size: 0.75rem; color: var(--dead);">
      Data checked at {d.checked_at || "—"} · extracted from aisecuritymatrix.com
    </p>
  </article>
</Layout>

<style>
  .gh-og {
    margin: 1.5rem 0;
  }
  .gh-og img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .gh-og figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--dead);
  }
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .pill-link {
    text-decoration: none;
  }
  .cat-chip {
    display: inline-block;
    white-space: nowrap;
    border-radius: 9999px;
    padding: 0.125rem 0.625rem;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--alive);
    background: color-mix(in srgb, var(--chip) 28%, transparent);
    transition: box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .cat-chip:hover {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--scope-ink) 28%, transparent);
    background: color-mix(in srgb, var(--chip) 42%, transparent);
  }
</style>
